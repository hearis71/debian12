<JWM>

  <StartupCommand>
    xsetroot -solid "#1a1a1a"
  </StartupCommand>

  <Desktops>
    <Desktop name="Workspace"/>
  </Desktops>

  <FocusModel>click</FocusModel>

  <DoubleClickSpeed>400</DoubleClickSpeed>

  <Border>2</Border>
  <TitleHeight>20</TitleHeight>

  <!-- Taskbar -->
  <Tray x="0" y="-1" height="26" autohide="false">
    <TaskList maxwidth="256"/>
    <Spacer width="10"/>
    <Clock format="%H:%M"/>
  </Tray>

  <!-- Mouse menu -->
  <RootMenu onroot="12">
    <Program label="Terminal">xterm</Program>
    <Program label="Firefox">firefox-esr</Program>
    <Separator/>
    <Program label="Neofetch">xterm -e neofetch</Program>
    <Program label="Ranger">xterm -e ranger</Program>
    <Separator/>
    <Restart label="Restart WM"/>
    <Exit label="Exit"/>
  </RootMenu>

  <!-- Minimal keyboard, non-conflicting -->
  <Key key="Ctrl+Alt+Return">
    <Exec>xterm</Exec>
  </Key>

</JWM>
